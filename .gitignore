bin/
knowledge.db
knowledge.db-*
.env

# The corpus itself is NOT ignored: docs/ is the source of truth (knowledge.db is
# derived from it), and a BA-confirmed answer lands in docs/qa/*.md precisely so it
# is reviewable in a diff and backed up by git. Only the empty-checkout marker is
# tracked here; add your own documents alongside it.

# Vendored CDN assets — fetch with `make vendor`, never commit (the .gitkeep is tracked
# so //go:embed always has a match).
web/vendor/*
!web/vendor/.gitkeep

# Build-time-only tool cache (mermaid for `make diagram`) — never a dependency
# of the product, so it is fetched on demand and not committed.
.cache/
