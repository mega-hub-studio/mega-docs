# Copy to .env and fill in. Anything not set falls back to the defaults below.

# --- AI provider (OpenAI-compatible) ---
# Chat endpoint. Anything that speaks POST /chat/completions works:
# OpenAI:      https://api.openai.com/v1
# Groq:        https://api.groq.com/openai/v1
# Together:    https://api.together.xyz/v1
# OpenRouter:  https://openrouter.ai/api/v1
# OpenCode:    take the base URL and model names from https://opencode.ai/docs/
#              — then run `make live`, which reports in a few seconds whether it
#              serves embeddings too (see EMBED_BASE_URL below if it doesn't).
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=sk-...

# Embeddings endpoint. Leave empty to use AI_BASE_URL for both.
#
# Set it when your chat provider has no /embeddings — common for coding-agent
# gateways, and fatal for a RAG index, since ingest cannot run without vectors.
# Two ways out, both leaving chat where it is:
#
#   OpenAI for embeddings only (paid, nothing to run):
#     EMBED_BASE_URL=https://api.openai.com/v1
#     EMBED_API_KEY=sk-...            # an OpenAI key — see the note below
#     EMBED_MODEL=text-embedding-3-small
#     EMBED_DIM=1536
#
#     EMBED_BASE_URL=http://localhost:11434/v1
#     EMBED_MODEL=nomic-embed-text
#     EMBED_DIM=768
EMBED_BASE_URL=

# Only needed when EMBED_BASE_URL is a *different vendor* from AI_BASE_URL: one key
# is not valid at two providers, so splitting the URL without splitting the key just
# fails auth. Leave empty to use AI_API_KEY for both (the usual case, including
EMBED_API_KEY=

# --- Models ---
EMBED_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini
# IMPORTANT: EMBED_DIM must match what the model actually returns.
#   text-embedding-3-small -> 1536   (the default here)
#   text-embedding-3-large -> 3072
# Do not set a shortened width like 512 for text-embedding-3-*: OpenAI supports it
# via a `dimensions` request field, which this client does not send, so you would
# get 1536 vectors into a 512-wide table and the insert would fail.
# Changing the embedding model requires a full re-ingest (delete knowledge.db) —
# vectors from two models are not comparable.
EMBED_DIM=1536

# --- App / hosting (see the Deploy page: /deploy) ---
# Loopback by default. This app has no access control of its own, so leaving
# loopback is deliberate: whoever reaches the port can read every indexed
# document. Recommended: keep 127.0.0.1 and publish it with `tailscale serve`
# or a Cloudflare Tunnel, which handle TLS and identity for you.
BIND_ADDR=127.0.0.1
PORT=8080

# Optional HTTP Basic auth. Empty = no auth. Required if you expose this beyond a
# tailnet/VPN (e.g. Tailscale Funnel). /api/health stays open so probes work.
AUTH_USER=team
AUTH_PASS=

# The BA write gate. Confirming an answer into the documents (and dismissing a
# question) needs this password; asking, reading the queue and filing a gap never do.
# Empty means this instance has NO write surface at all — BA mode says so instead of
# failing on submit. Keep it different from AUTH_PASS: that one is shared by everyone
# who reads, and publishing into the knowledge base is not everyone's job.
BA_PASS=

# Where documents live. `ingest` reads it, and a BA-confirmed answer is written into
# CORPUS_DIR/qa/ticket-N.md — which is what keeps knowledge.db *derived*: this folder
# is the source of truth, so put it in git. The process needs write access to it.
CORPUS_DIR=docs

DB_PATH=knowledge.db
TOP_K=6

# --- What the status line reports (all optional, all zero = hidden) ---
# The strip under the prompt shows what an answer actually cost. Token counts come
# from the provider's own usage frame, so they need no configuration. These two do:
#   CONTEXT_WINDOW  the chat model's window in tokens; enables the "% of window" figure
#   PRICE_IN/OUT    USD per 1M prompt / completion tokens, from your provider's prices
# Left at 0 the UI prints nothing rather than a zero — an unmeasured cost and a cost
# of nothing are different facts, and only one of them is worth showing.
CONTEXT_WINDOW=0
PRICE_IN=0
PRICE_OUT=0

# --- Frontend assets ---
# Where the browser loads Vue / marked / DOMPurify / 8bit-nes from. Versions are
# pinned (and SRI-verified) in web/index.html; this only sets the base URL.
#   https://cdn.jsdelivr.net/npm   default — jsDelivr, immutable + long-cached
#   https://unpkg.com              same tarballs, same digests
#   /vendor                        served from the binary; run `make vendor` first
#                                  (no egress needed at runtime)
ASSET_BASE=https://cdn.jsdelivr.net/npm
