# Copy to .env and fill in. Anything not set falls back to the defaults below.

# --- AI provider (OpenAI-compatible) ---
# Chat endpoint. Anything that speaks POST /chat/completions works:
# OpenAI:      https://api.openai.com/v1
# Groq:        https://api.groq.com/openai/v1
# Together:    https://api.together.xyz/v1
# OpenRouter:  https://openrouter.ai/api/v1
# Ollama:      http://localhost:11434/v1   (fully local, free)
# OpenCode:    take the base URL and model names from https://opencode.ai/docs/
#              — then run `make live`, which reports in a few seconds whether it
#              serves embeddings too (see EMBED_BASE_URL below if it doesn't).
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=sk-...

# Embeddings endpoint. Leave empty to use AI_BASE_URL for both.
#
# Set it when your chat provider has no /embeddings — common for coding-agent
# gateways, and fatal for a RAG index, since ingest cannot run without vectors.
# A local Ollama is the cheapest fix:
#   EMBED_BASE_URL=http://localhost:11434/v1
#   EMBED_MODEL=nomic-embed-text
#   EMBED_DIM=768
EMBED_BASE_URL=

# --- Models ---
EMBED_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini
# IMPORTANT: EMBED_DIM must match EMBED_MODEL.
#   text-embedding-3-small -> 1536
#   text-embedding-3-large -> 3072
#   nomic-embed-text (ollama) -> 768
# Changing the embedding model requires a full re-ingest (delete knowledge.db).
EMBED_DIM=1536

# --- App / hosting (see SELFHOST.md) ---
# Loopback by default. This app has no access control of its own, so leaving
# loopback is deliberate: whoever reaches the port can read every indexed
# document. Recommended: keep 127.0.0.1 and publish it with `tailscale serve`
# or a Cloudflare Tunnel, which handle TLS and identity for you.
BIND_ADDR=127.0.0.1
PORT=8080

# Optional HTTP Basic auth. Empty = no auth. Required if you expose this beyond a
# tailnet/VPN (e.g. Tailscale Funnel). /api/health stays open so probes work.
AUTH_USER=team
AUTH_PASS=
DB_PATH=knowledge.db
TOP_K=6

# --- Frontend assets ---
# Where the browser loads Vue / marked / DOMPurify / 8bit-nes from. Versions are
# pinned (and SRI-verified) in web/index.html; this only sets the base URL.
#   https://cdn.jsdelivr.net/npm   default — jsDelivr, immutable + long-cached
#   https://unpkg.com              same tarballs, same digests
#   /vendor                        served from the binary; run `make vendor` first
#                                  (no egress needed at runtime)
ASSET_BASE=https://cdn.jsdelivr.net/npm
