# Copy to .env and set AI_API_KEY. Every other line here is already its default —
# delete what you do not change. Existing OS env wins over this file, so a systemd
# unit can override it without editing anything.

# --- provider (OpenAI) -------------------------------------------------------
# Any OpenAI-compatible base URL works (Azure, Groq, OpenRouter) — that is a
# property of the wire format, not a feature this repo maintains. Run `make live`
# against a new one: it reports in seconds whether it serves /embeddings too,
# which is the one gap that stops ingest dead.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=sk-...

# Split these two ONLY when the chat provider has no /embeddings. A key is not
# valid at two vendors, so splitting the URL without the key just fails auth.
EMBED_BASE_URL=
EMBED_API_KEY=

# --- models ------------------------------------------------------------------
# EMBED_DIM must equal what the model returns (3-small 1536 · 3-large 3072). This
# client sends no `dimensions` field, so a shortened width fails on insert, and
# changing the embedding model needs a full re-ingest — vectors from two models
# are not comparable.
EMBED_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini
EMBED_DIM=1536
TOP_K=6

# --- hosting -----------------------------------------------------------------
# Loopback is deliberate: whoever reaches the port reads every indexed document.
# Publish it with `tailscale serve` or a Cloudflare Tunnel rather than opening it.
BIND_ADDR=127.0.0.1
PORT=8080

# Optional HTTP Basic auth over everything except /api/health. Empty = no auth.
AUTH_USER=team
AUTH_PASS=

# The BA write gate — confirm and dismiss need it; asking and reading never do.
# Empty means this instance has NO write surface, and BA mode says so up front.
# Keep it different from AUTH_PASS: readers share that one.
BA_PASS=

# --- storage -----------------------------------------------------------------
# CORPUS_DIR is the source of truth today and knowledge.db is derived from it, so
# put this folder in git; the process needs write access (a confirmed answer is
# written to CORPUS_DIR/qa/ticket-N.md). See "Now vs vNext" in README.md — the
# brief inverts this, and the migration runner it needs first does not exist yet.
CORPUS_DIR=docs
DB_PATH=knowledge.db

# --- status line + guide link (optional) -------------------------------------
# Zero hides the figure: an unmeasured cost and a cost of nothing are different
# facts. Token counts come from the provider's usage frame and need no config.
CONTEXT_WINDOW=0
PRICE_IN=0
PRICE_OUT=0
