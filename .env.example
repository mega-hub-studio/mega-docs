# Copy to .env and fill in. Anything not set falls back to the defaults below.

# --- AI provider (OpenAI-compatible) ---
# OpenAI:      https://api.openai.com/v1
# Groq:        https://api.groq.com/openai/v1
# Together:    https://api.together.xyz/v1
# OpenRouter:  https://openrouter.ai/api/v1
# Ollama:      http://localhost:11434/v1   (fully local, free)
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=sk-...

# --- Models ---
EMBED_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini
# IMPORTANT: EMBED_DIM must match EMBED_MODEL.
#   text-embedding-3-small -> 1536
#   text-embedding-3-large -> 3072
#   nomic-embed-text (ollama) -> 768
# Changing the embedding model requires a full re-ingest (delete knowledge.db).
EMBED_DIM=1536

# --- App ---
PORT=8080
DB_PATH=knowledge.db
TOP_K=6
